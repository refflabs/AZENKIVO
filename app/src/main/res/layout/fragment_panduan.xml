<?xml version="1.0" encoding="utf-8"?>
<!-- Panduan SOP AZENKIVO -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical"
    tools:context=".Panduan.PanduanFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/canvas"
        android:theme="@style/ThemeOverlay.Azenkivo.Toolbar"
        app:contentInsetStart="24dp"
        app:popupTheme="@style/ThemeOverlay.Azenkivo.Toolbar"
        app:subtitleTextAppearance="@style/AzenkivoToolbarSubtitle"
        app:subtitleTextColor="@color/ink_secondary"
        app:titleTextAppearance="@style/AzenkivoToolbarTitle"
        app:titleTextColor="@color/ink" />

    <TextView
        style="@style/Azenkivo.Type.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        android:text="@string/pand_intro" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Azenkivo.Type.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/pand_list_title"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvJumlahSop"
            style="@style/Azenkivo.Type.BodySmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="8 panduan" />
    </LinearLayout>

    <!-- Satu grup daftar: permukaan putih, garis 1dp, sudut 16dp -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/stroke"
        app:strokeWidth="1dp">

        <ListView
            android:id="@+id/listViewSop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/stroke"
            android:dividerHeight="1dp"
            android:listSelector="@android:color/transparent"
            android:scrollbars="none" />
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
