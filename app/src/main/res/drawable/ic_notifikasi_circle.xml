<?xml version="1.0" encoding="utf-8"?>
<!-- Ikon lonceng di dalam lingkaran merah gelap (seperti di header Figma) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="36dp"
        android:height="36dp">
        <shape android:shape="oval">
            <solid android:color="@color/emergency_red_dark" />
        </shape>
    </item>
    <item
        android:width="20dp"
        android:height="20dp"
        android:drawable="@drawable/ic_notifikasi"
        android:gravity="center" />
</layer-list>
