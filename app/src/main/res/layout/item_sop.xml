<?xml version="1.0" encoding="utf-8"?>
<!-- Satu baris daftar SOP -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Kategori kecil di atas judul -->
        <TextView
            android:id="@+id/tvKategoriSop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jakarta_semibold"
            android:textColor="@color/accent_strong"
            android:textSize="12sp"
            tools:text="Pertolongan Pertama (P3K)" />

        <TextView
            android:id="@android:id/text1"
            style="@style/Azenkivo.Type.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/jakarta_bold"
            android:textSize="16sp"
            tools:text="Resusitasi Jantung Paru (CPR)" />

        <TextView
            android:id="@android:id/text2"
            style="@style/Azenkivo.Type.BodySmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            tools:text="Penanganan henti napas &amp; henti jantung" />
    </LinearLayout>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="12dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/ink_muted" />
</LinearLayout>
