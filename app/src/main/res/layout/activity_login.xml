<?xml version="1.0" encoding="utf-8"?>
<!-- Login AZENKIVO -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    tools:context=".LoginActivity">

    <ScrollView
        android:id="@+id/scrollLogin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- Header brand: tanda logo navy + nama aplikasi -->
            <LinearLayout
                android:id="@+id/layoutBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_brand_mark">

                    <ImageView
                        android:id="@+id/ivLoginLogo"
                        android:layout_width="22dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/login_logo_desc"
                        android:src="@drawable/ic_shield_logo" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvBrandName"
                    style="@style/Azenkivo.Type.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:letterSpacing="0.06"
                    android:text="@string/app_name"
                    android:textSize="16sp"
                    android:fontFamily="@font/jakarta_bold" />
            </LinearLayout>

            <!-- Judul halaman -->
            <TextView
                android:id="@+id/tvLoginOverline"
                style="@style/Azenkivo.Type.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:text="@string/login_overline" />

            <TextView
                android:id="@+id/tvLoginTitle"
                style="@style/Azenkivo.Type.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityHeading="true"
                android:text="@string/login_heading"
                android:fontFamily="@font/jakarta_bold" />

            <TextView
                android:id="@+id/tvLoginSubtitle"
                style="@style/Azenkivo.Type.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/login_caption"
                android:fontFamily="@font/jakarta_regular" />

            <!-- Form dalam CardView: flat, sudut 16dp, garis halus #E2E8F0 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardUseCompatPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_group_surface"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="20dp">

                    <!-- Form -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilUsername"
                        style="@style/Azenkivo.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/login_label_username"
                        app:helperText="@string/login_helper_username"
                        app:startIconDrawable="@drawable/ic_person">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etUsername"
                            style="@style/Azenkivo.Type.Input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="username"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="yes"
                            android:inputType="text|textNoSuggestions"
                            android:maxLines="1"
                            android:minHeight="56dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPassword"
                        style="@style/Azenkivo.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="@string/login_label_password"
                        app:endIconMode="password_toggle"
                        app:helperText="@string/login_helper_password"
                        app:startIconDrawable="@drawable/ic_lock">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            style="@style/Azenkivo.Type.Input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="password"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="yes"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:minHeight="56dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Lupa Sandi: tautan rata kanan -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tvLupaSandi"
                        style="@style/Azenkivo.Button.Link"
                        android:layout_width="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="-8dp"
                        android:text="@string/login_forgot" />

                    <!-- Aksi -->
                    <!-- Tombol utama: Deep Slate Navy solid -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogin"
                        style="@style/Azenkivo.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_marginTop="16dp"
                        android:text="@string/login_submit" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Tombol sekunder: outlined putih, ikon perisai netral -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTamu"
                style="@style/Azenkivo.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:text="@string/login_guest"
                app:icon="@drawable/ic_shield"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="20dp" />

            <!-- Pendorong: tautan daftar menempel di bawah layar tinggi -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp" />

            <!-- Daftar Relawan -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/Azenkivo.Type.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_no_account" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tvDaftarRelawan"
                    style="@style/Azenkivo.Button.Link"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/login_register" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
