<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Izin internet: untuk Glide dan WebView Info BMKG -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Izin lokasi -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AZENKIVO">

        <!-- SplashActivity kembali menjadi Launcher utama -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AZENKIVO.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Halaman Tutorial (setelah SplashActivity, terdiri dari 3 Fragment) -->
        <activity
            android:name=".TutorialActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Halaman Login -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Halaman utama setelah login + Bottom Navigation -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Detail Proyek AZENKIVO -->
        <activity
            android:name=".DetailActivity"
            android:exported="false" />

        <!-- Detail SOP P3K & mitigasi -->
        <activity
            android:name=".SopDetailActivity"
            android:exported="false" />

        <!-- Halaman Info BMKG -->
        <activity
            android:name=".WebViewActivity"
            android:exported="false" />

    </application>

</manifest>
