<?xml version="1.0" encoding="utf-8"?>
<!-- Tutorial Screen AZENKIVO (Setelah SplashActivity, berisi 3 Fragment) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    tools:context=".TutorialActivity">

    <!-- Header gelombang bg_header_wafe -->
    <ImageView
        android:id="@+id/ivHeaderWafeTutorial"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/bg_header_wafe"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Baris atas: Brand AZENKIVO + Tombol Lewati -->
    <LinearLayout
        android:id="@+id/topBarTutorial"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_status_badge">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_shield_logo" />
        </FrameLayout>

        <TextView
            style="@style/Azenkivo.Type.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:letterSpacing="0.06"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSkip"
            style="@style/Azenkivo.Button.Link"
            android:layout_width="wrap_content"
            android:text="@string/tut_skip"
            android:textColor="@color/white" />
    </LinearLayout>

    <!-- ViewPager2 untuk menampung 3 Fragment Tutorial -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerTutorial"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomBarTutorial"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivHeaderWafeTutorial" />

    <!-- Navigasi bawah: Indikator titik 3 halaman + Tombol Kembali & Selanjutnya/Mulai -->
    <LinearLayout
        android:id="@+id/bottomBarTutorial"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Indikator halaman: DotsIndicator (Modul P9 6.2) -->
        <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
            android:id="@+id/dot_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            app:dotsColor="@color/stroke"
            app:dotsCornerRadius="4dp"
            app:dotsSize="8dp"
            app:dotsSpacing="4dp"
            app:dotsWidthFactor="3"
            app:progressMode="false"
            app:selectedDotColor="@color/brand" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrev"
                style="@style/Azenkivo.Button.Secondary"
                android:layout_width="0dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:text="@string/tut_prev"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                style="@style/Azenkivo.Button.Primary"
                android:layout_width="0dp"
                android:layout_weight="1.5"
                android:text="@string/tut_next" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
