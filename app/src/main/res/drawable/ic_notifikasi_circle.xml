<?xml version="1.0" encoding="utf-8"?>
<!-- Ikon lonceng Toolbar: lingkaran putih bergaris halus + lonceng navy, keduanya di tengah -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="32dp"
        android:height="32dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/surface" />
            <stroke
                android:width="1dp"
                android:color="@color/stroke" />
        </shape>
    </item>
    <item
        android:width="18dp"
        android:height="18dp"
        android:drawable="@drawable/ic_notifikasi_ink"
        android:gravity="center" />
</layer-list>
