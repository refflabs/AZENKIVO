<?xml version="1.0" encoding="utf-8"?>
<!-- Detail Proyek AZENKIVO -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    tools:context=".DetailActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/canvas"
        android:theme="@style/ThemeOverlay.Azenkivo.Toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/ThemeOverlay.Azenkivo.Toolbar"
        app:titleTextAppearance="@style/AzenkivoToolbarTitle"
        app:titleTextColor="@color/ink"
        tools:title="Detail Proyek" />

    <ScrollView
        android:id="@+id/scrollDetail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- Banner proyek -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgHeader"
                android:layout_width="match_parent"
                android:layout_height="192dp"
                android:background="@color/brand"
                android:contentDescription="@string/dp_header_desc"
                android:scaleType="centerCrop"
                android:src="@drawable/ill_project_banner"
                app:shapeAppearanceOverlay="@style/Azenkivo.Shape.Rounded16" />

            <TextView
                style="@style/Azenkivo.Type.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/dp_overline"
                android:textColor="@color/accent_strong" />

            <TextView
                android:id="@+id/tvJudulProyek"
                style="@style/Azenkivo.Type.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityHeading="true"
                android:letterSpacing="0.02"
                android:text="@string/app_name" />

            <TextView
                android:id="@+id/tvTagline"
                style="@style/Azenkivo.Type.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/dp_tagline"
                android:textColor="@color/ink_secondary"
                android:textSize="16sp" />

            <!-- Chip platform -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_neutral"
                    android:fontFamily="@font/jakarta_semibold"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="@string/dp_chip_platform"
                    android:textColor="@color/ink"
                    android:textSize="13sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_neutral"
                    android:fontFamily="@font/jakarta_semibold"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="@string/dp_chip_lang"
                    android:textColor="@color/ink"
                    android:textSize="13sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_neutral"
                    android:fontFamily="@font/jakarta_semibold"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="@string/dp_chip_ui"
                    android:textColor="@color/ink"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Deskripsi proyek -->
            <TextView
                android:id="@+id/tvDeskripsiProyek"
                style="@style/Azenkivo.Type.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingMultiplier="1.4"
                android:text="@string/detail_desc"
                android:textColor="@color/ink" />

            <!-- Fitur unggulan -->
            <TextView
                style="@style/Azenkivo.Type.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:accessibilityHeading="true"
                android:text="@string/dp_features_title"
                android:textSize="18sp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardFitur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_group_surface"
                    android:orientation="vertical">
                    <!-- Fitur 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:screenReaderFocusable="true">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_tile"
                            android:backgroundTint="@color/danger_tint">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_shield"
                                app:tint="@color/danger" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Azenkivo.Type.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/jakarta_bold"
                                android:text="@string/dp_f1_title"
                                android:textSize="15sp" />

                            <TextView
                                style="@style/Azenkivo.Type.BodySmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingMultiplier="1.35"
                                android:text="@string/dp_f1_body" />
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="72dp"
                        android:background="@color/stroke" />
                    <!-- Fitur 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:screenReaderFocusable="true">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_tile"
                            android:backgroundTint="@color/accent_tint">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_tracking"
                                app:tint="@color/accent" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Azenkivo.Type.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/jakarta_bold"
                                android:text="@string/dp_f2_title"
                                android:textSize="15sp" />

                            <TextView
                                style="@style/Azenkivo.Type.BodySmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingMultiplier="1.35"
                                android:text="@string/dp_f2_body" />
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="72dp"
                        android:background="@color/stroke" />
                    <!-- Fitur 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:screenReaderFocusable="true">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_tile"
                            android:backgroundTint="@color/brand_tint">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_panduan"
                                app:tint="@color/brand" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Azenkivo.Type.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/jakarta_bold"
                                android:text="@string/dp_f3_title"
                                android:textSize="15sp" />

                            <TextView
                                style="@style/Azenkivo.Type.BodySmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingMultiplier="1.35"
                                android:text="@string/dp_f3_body" />
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="72dp"
                        android:background="@color/stroke" />
                    <!-- Fitur 4 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:screenReaderFocusable="true">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_tile"
                            android:backgroundTint="@color/brand_tint">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_call"
                                app:tint="@color/brand" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Azenkivo.Type.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/jakarta_bold"
                                android:text="@string/dp_f4_title"
                                android:textSize="15sp" />

                            <TextView
                                style="@style/Azenkivo.Type.BodySmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingMultiplier="1.35"
                                android:text="@string/dp_f4_body" />
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="72dp"
                        android:background="@color/stroke" />
                    <!-- Fitur 5 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:screenReaderFocusable="true">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_tile"
                            android:backgroundTint="@color/brand_tint">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_water_drop"
                                app:tint="@color/brand" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Azenkivo.Type.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/jakarta_bold"
                                android:text="@string/dp_f5_title"
                                android:textSize="15sp" />

                            <TextView
                                style="@style/Azenkivo.Type.BodySmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingMultiplier="1.35"
                                android:text="@string/dp_f5_body" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Teknologi -->
            <TextView
                style="@style/Azenkivo.Type.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:accessibilityHeading="true"
                android:text="@string/dp_tech_title"
                android:textSize="18sp" />

            <TextView
                style="@style/Azenkivo.Type.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.5"
                android:text="@string/dp_tech_body" />

            <!-- Kembali ke MainActivity -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKembali"
                style="@style/Azenkivo.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_marginTop="32dp"
                android:text="@string/btn_back" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
