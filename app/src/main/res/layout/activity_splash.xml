<?xml version="1.0" encoding="utf-8"?>
<!-- Splash AZENKIVO: logo, nama, loading bulat -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient"
    tools:context=".SplashActivity">

    <!-- Logo perisai (ukuran sama dengan splash sistem) -->
    <ImageView
        android:id="@+id/ivSplashLogo"
        android:layout_width="80dp"
        android:layout_height="96dp"
        android:contentDescription="@string/login_logo_desc"
        android:src="@drawable/ic_shield_logo"
        app:layout_constraintBottom_toTopOf="@+id/tvSplashTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tvSplashTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/jakarta_bold"
        android:includeFontPadding="false"
        android:letterSpacing="0.08"
        android:text="@string/app_name"
        android:textColor="@color/white"
        android:textSize="28sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivSplashLogo" />

    <!-- Loading: bola titik bernapas -->
    <com.example.azenkivo.ui.custom.ThinkingOrbView
        android:id="@+id/thinkingOrbs"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="64dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
