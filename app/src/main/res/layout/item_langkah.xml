<?xml version="1.0" encoding="utf-8"?>
<!-- Satu langkah timeline di Detail SOP -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:screenReaderFocusable="true">

    <TextView
        android:id="@+id/tvNomorLangkah"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_step_number"
        android:fontFamily="@font/jakarta_bold"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="1" />

    <!-- Garis penghubung timeline -->
    <View
        android:id="@+id/viewGaris"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="@color/stroke"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/tvNomorLangkah"
        app:layout_constraintStart_toStartOf="@+id/tvNomorLangkah"
        app:layout_constraintTop_toBottomOf="@+id/tvNomorLangkah" />

    <TextView
        android:id="@+id/tvLangkahJudul"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:fontFamily="@font/jakarta_bold"
        android:importantForAccessibility="no"
        android:minHeight="32dp"
        android:gravity="center_vertical"
        android:textColor="@color/ink"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvNomorLangkah"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Cek respon &amp; kesadaran korban" />

    <TextView
        android:id="@+id/tvLangkahIsi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/jakarta_regular"
        android:importantForAccessibility="no"
        android:lineSpacingMultiplier="1.4"
        android:paddingBottom="24dp"
        android:textColor="@color/ink_secondary"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvLangkahJudul"
        app:layout_constraintTop_toBottomOf="@+id/tvLangkahJudul"
        tools:text="Tepuk bahu perlahan dan panggil dengan suara lantang." />

</androidx.constraintlayout.widget.ConstraintLayout>
