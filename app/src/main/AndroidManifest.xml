<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Izin internet: untuk Glide (foto unit responder) dan WebView Info BMKG -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_azenkivo_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_azenkivo_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.AZENKIVO">

        <!-- SplashActivity kembali menjadi Launcher utama (Modul P7 langkah 2.4) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AZENKIVO.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Halaman Login (diarahkan dari SplashActivity jika belum login) -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Halaman utama dengan Bottom Navigation (pengganti MainActivity) -->
        <activity
            android:name=".BaseActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Halaman Detail SOP Darurat -->
        <activity
            android:name=".DetailActivity"
            android:exported="false" />

        <!-- Halaman Info BMKG (WebView) -->
        <activity
            android:name=".WebViewActivity"
            android:exported="false" />

    </application>

</manifest>
