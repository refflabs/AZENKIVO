<?xml version="1.0" encoding="utf-8"?>
<!-- Palet AZENKIVO "Guardian Shield" -->
<resources>
    <!-- 1. Token semantik -->
    <!-- Brand: Deep Slate Navy -->
    <color name="brand">#0F172A</color>
    <color name="brand_pressed">#1E293B</color>
    <color name="brand_tint">#F1F5F9</color>

    <!-- Aksen responder / tracking: Blue 600 -->
    <color name="accent">#2563EB</color>
    <color name="accent_strong">#1D4ED8</color>
    <color name="accent_tint">#EFF6FF</color>

    <!-- Darurat: Red 600 -->
    <color name="danger">#C4352B</color>
    <color name="danger_strong">#9E2A22</color>
    <color name="danger_tint">#FBEDEB</color>

    <!-- Cincin halo tombol SOS -->
    <color name="danger_halo">#F0CBC6</color>

    <!-- Status semantik kecil -->
    <color name="status_safe">#4ADE80</color>
    <color name="status_warning">#FBBF24</color>

    <!-- Status responder -->
    <color name="status_online">#16A34A</color>
    <color name="status_patrol">#B45309</color>

    <!-- Peta simulasi Tracking -->
    <color name="map_bg">#E9EEF5</color>
    <color name="map_block">#DCE3EC</color>

    <!-- Indikator pill tab aktif bottom nav -->
    <color name="nav_indicator">#E2E8F0</color>

    <!-- Latar halaman & permukaan komponen -->
    <color name="canvas">#F8FAFC</color>
    <color name="surface">#FFFFFF</color>

    <!-- Teks -->
    <color name="ink">#0F172A</color>
    <color name="ink_secondary">#64748B</color>
    <color name="ink_muted">#94A3B8</color>

    <!-- Garis halus -->
    <color name="stroke">#E2E8F0</color>

    <!-- 2. Nama lama -->
    <!-- emergency_* tetap merah: dipakai tombol SOS, header darurat -->
    <color name="emergency_red">@color/danger</color>
    <color name="emergency_red_dark">@color/danger_strong</color>
    <color name="emergency_red_light">@color/danger_tint</color>

    <color name="safety_blue">@color/accent</color>
    <color name="safety_blue_dark">@color/accent_strong</color>
    <color name="safety_blue_light">@color/accent_tint</color>

    <color name="safety_orange">#F57C00</color>
    <color name="safety_orange_light">#FFF3E0</color>

    <color name="safety_green">#2E7D32</color>
    <color name="safety_green_light">#E8F5E9</color>

    <color name="text_primary">@color/ink</color>
    <color name="text_secondary">@color/ink_secondary</color>
    <color name="text_hint">@color/ink_muted</color>

    <color name="card_bg">@color/surface</color>
    <color name="card_stroke">@color/stroke</color>
    <color name="background_light">@color/canvas</color>

    <color name="navy_bg">@color/brand_pressed</color>
    <color name="on_navy_secondary">#CBD5E1</color>

    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>

    <!-- Warna Modul Pertemuan 9 (Tutorial Screen & DotsIndicator) -->
    <color name="tutorial_blue">#64B5F6</color>
    <color name="tutorial_green">#AED581</color>
    <color name="tutorial_teal">#4DB6AC</color>
    <color name="abu_gelap">#94A3B8</color>
    <color name="dot_selected">#0F172A</color>
</resources>
